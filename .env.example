# Образец переменных окружения. Скопируйте в `.env.local` и заполните.
# `.env.local` в git не попадает — значения берите в дашбордах сервисов
# или у того, кто настраивал проект.

# ── База данных ───────────────────────────────────────────────────────────────
# Строка подключения Neon. Обязательно с `?sslmode=require`.
# Внимание: база одна на все окружения, отдельной dev-базы в проекте нет —
# локальные миграции идут в тот же Postgres, что и продакшен.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Аутентификация (better-auth) ──────────────────────────────────────────────
# Секрет для подписи сессий. Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Базовый адрес приложения для better-auth.
BETTER_AUTH_URL=http://localhost:3000
# Тот же адрес, но доступный клиенту: используется auth-client и ссылками в письмах.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Вход через Google ─────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Почта (Resend) ────────────────────────────────────────────────────────────
# Письма подтверждения адреса и сброса пароля.
RESEND_API_KEY=

# ── Хранилище файлов (Vercel Blob) ────────────────────────────────────────────
# Нужен для загрузки фотографий объявлений и аватара.
# Создаётся автоматически при подключении Blob store к проекту; локально
# подтягивается командой `vercel env pull` (store должен быть подключён
# к окружению Development).
#
# Без него приложение запустится, но загрузка файлов будет отказывать.
BLOB_READ_WRITE_TOKEN=
